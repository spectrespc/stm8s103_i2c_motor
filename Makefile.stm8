# Makefile.stm8 - firmware build for the OKO STM8S103F3P6 motor controller.
#
# This file is NOT called by the SDK build: `project/app/Makefile` builds every
# subdirectory that contains a `Makefile`, and the main builder image has no
# SDCC.  The SDK wrapper is `Makefile` (host `oko-motor` only); this file is
# run inside tools/stm8-sdcc:
#
#   docker run --rm -v "$PWD:/work" -w /work/project/app/stm8-motor \
#       oko-stm8-sdcc make -f Makefile.stm8 all
#
# Board variants: BOARD=oko (default, production lens pin map) or BOARD=test
# (STM8S003F3P6 test bench wiring).  The pin map is selected at compile time;
# build/.board records the variant and forces a full recompile when BOARD
# changes, so a mixed build cannot silently flash the wrong pin map.
#
# Layout: boot 0x8000..0x89FF, header 0x8A00..0x8A0F, app 0x8A10..0x9FFF.
SPL_ROOT ?= $(HOME)/STM8-SPL-SDCC
SPL_INC  := $(SPL_ROOT)/Libraries/STM8S_StdPeriph_Driver/inc
SPL_CONF := $(SPL_ROOT)/Libraries/STM8S_StdPeriph_Driver/conf
SPL_LIB  := $(SPL_ROOT)/Libraries/STM8S_StdPeriph_Driver/STM8S103/spl.lib
DEVICE   := STM8S103

CC       := sdcc
CFLAGS   := -mstm8 --std-sdcc11 --opt-code-size -D$(DEVICE)
INCLUDE  := -Isrc/core -Isrc/hal -Isrc/i2c -Isrc/motor -Isrc/common \
            -I$(SPL_INC) -I$(SPL_CONF)
BUILD    := build

# The test board uses a different pin map and therefore gets a different minor
# version: 2.1.1 can never be mistaken for the 2.0.2 production firmware, and
# neither /api/flash nor `oko-motor check` accepts the wrong artifact.
BOARD ?= oko
ifeq ($(BOARD),test)
CFLAGS      += -DBOARD_TEST \
               -DAPP_VERSION_MAJOR=2 -DAPP_VERSION_MINOR=1 -DAPP_VERSION_PATCH=1
APP_VERSION := 2.1.1
else
APP_VERSION := $(shell awk '/define[[:space:]]+APP_VERSION_(MAJOR|MINOR|PATCH)/{printf "%s.", $$3}' \
	src/core/main.h | sed 's/\.$$//')
endif

# stm8flash device profile; both boards carry an STM8S003F3P6 (the STM8S103
# SPL/register set above is used because both dies share the same register map).
FLASH_DEV ?= stm8s003f3

# Records the BOARD the objects were compiled for.  The .rel files do not
# depend on BOARD themselves, so without this marker a BOARD switch would only
# relink old objects and mislabel them with the new version.
BOARD_STAMP := $(BUILD)/.board

BOOT_SRC := src/boot/boot.c src/boot/boot_hw.c src/boot/boot_i2c.c \
            src/boot/boot_flash.c src/common/oko_crc.c
APP_SRC  := src/core/main.c src/hal/hw_config.c src/hal/stm8s_it.c \
            src/i2c/i2c_slave.c src/motor/stepper.c src/motor/eeprom.c
BOOT_OBJ := $(addprefix $(BUILD)/boot_,$(notdir $(BOOT_SRC:.c=.rel)))
APP_OBJ  := $(addprefix $(BUILD)/app_,$(notdir $(APP_SRC:.c=.rel)))

# The application version lives in src/core/main.h and also names the
# artifacts, so the WebUI can derive the expected version from the file name.
# The unversioned app.ihx/factory.ihx/app.bin stay as copies for ST-Link
# procedures and older documentation; they are not accepted by /api/flash.
# APP_VERSION itself is set above, per BOARD variant.

BOOT_IHX    := $(BUILD)/boot.ihx
APP_FW_IHX  := $(BUILD)/app-firmware.ihx
APP_IHX     := $(BUILD)/app-$(APP_VERSION).ihx
FACTORY_IHX := $(BUILD)/factory-$(APP_VERSION).ihx
APP_BIN     := $(BUILD)/app-$(APP_VERSION).bin
APP_IHX_ALIAS     := $(BUILD)/app.ihx
FACTORY_IHX_ALIAS := $(BUILD)/factory.ihx
APP_BIN_ALIAS     := $(BUILD)/app.bin

HEADERS := $(wildcard src/*/*.h) $(wildcard src/common/*.h)

.PHONY: all boot app factory clean flash verify size FORCE

all: $(APP_IHX) $(FACTORY_IHX) $(APP_IHX_ALIAS) $(FACTORY_IHX_ALIAS) \
     $(APP_BIN_ALIAS)

$(SPL_LIB):
	$(MAKE) -C $(SPL_ROOT)/Libraries/STM8S_StdPeriph_Driver DEVICE=$(DEVICE)

$(BUILD):
	mkdir -p $(BUILD)

# Rewrite the marker only when BOARD actually changed; each object depends on
# it, so a variant switch recompiles all sources instead of relinking stale ones.
FORCE:

$(BOARD_STAMP): FORCE | $(BUILD)
	@printf '%s\n' '$(BOARD)' | cmp -s - $@ || \
		printf '%s\n' '$(BOARD)' > $@

$(BOOT_OBJ) $(APP_OBJ): $(BOARD_STAMP)

# --- bootloader: register-level, no SPL library objects -------------------
$(BUILD)/boot_%.rel: src/boot/%.c $(HEADERS) | $(BUILD)
	$(CC) $(CFLAGS) --code-loc 0x8000 $(INCLUDE) -c $< -o $@

$(BUILD)/boot_oko_crc.rel: src/common/oko_crc.c $(HEADERS) | $(BUILD)
	$(CC) $(CFLAGS) --code-loc 0x8000 $(INCLUDE) -c $< -o $@

$(BOOT_IHX): $(BOOT_OBJ) $(BUILD)
	$(CC) $(CFLAGS) --code-loc 0x8000 -o $@ $(BOOT_OBJ)

# --- application: SPL, vector table at 0x8A10 -----------------------------
$(BUILD)/app_%.rel: src/core/%.c $(HEADERS) | $(BUILD)
	$(CC) $(CFLAGS) --code-loc 0x8A10 $(INCLUDE) -c $< -o $@

$(BUILD)/app_%.rel: src/hal/%.c $(HEADERS) | $(BUILD)
	$(CC) $(CFLAGS) --code-loc 0x8A10 $(INCLUDE) -c $< -o $@

$(BUILD)/app_%.rel: src/i2c/%.c $(HEADERS) | $(BUILD)
	$(CC) $(CFLAGS) --code-loc 0x8A10 $(INCLUDE) -c $< -o $@

$(BUILD)/app_%.rel: src/motor/%.c $(HEADERS) | $(BUILD)
	$(CC) $(CFLAGS) --code-loc 0x8A10 $(INCLUDE) -c $< -o $@

$(APP_FW_IHX): $(APP_OBJ) $(SPL_LIB) $(BUILD)
	$(CC) $(CFLAGS) --code-loc 0x8A10 -o $@ $(APP_OBJ) \
		-L$(dir $(SPL_LIB)) -lspl

# Header at 0x8A00 + app at 0x8A10; mkapp.py also enforces the size gate.
# All three outputs share one recipe.  They are independent targets, so
# serialize them: a parallel make would otherwise run mkapp.py concurrently
# for the same files.
.NOTPARALLEL: $(APP_IHX) $(FACTORY_IHX) $(APP_BIN)
$(APP_IHX) $(FACTORY_IHX) $(APP_BIN): $(APP_FW_IHX) $(BOOT_IHX) \
		tools/mkapp.py Makefile.stm8
	python3 tools/mkapp.py --boot $(BOOT_IHX) --app $(APP_FW_IHX) \
		--version $(APP_VERSION) \
		--out $(APP_IHX) --factory $(FACTORY_IHX) --bin $(APP_BIN)

$(APP_IHX_ALIAS): $(APP_IHX)
	cp -f $< $@

$(FACTORY_IHX_ALIAS): $(FACTORY_IHX)
	cp -f $< $@

$(APP_BIN_ALIAS): $(APP_BIN)
	cp -f $< $@

boot: $(BOOT_IHX)
app: $(APP_IHX)
factory: $(FACTORY_IHX)

size: $(APP_IHX)
	python3 tools/mkapp.py --check $(BOOT_IHX) $(APP_FW_IHX)

flash: $(FACTORY_IHX)
	stm8flash -c stlinkv2 -p $(FLASH_DEV) -s flash -w $(FACTORY_IHX)

verify: $(FACTORY_IHX)
	stm8flash -c stlinkv2 -p $(FLASH_DEV) -s flash -v $(FACTORY_IHX)

clean:
	rm -rf $(BUILD)